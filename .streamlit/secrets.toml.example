# Copia questo file in .streamlit/secrets.toml e inserisci la tua chiave
# reale SOLO in locale. Su Streamlit Community Cloud, i secrets si
# impostano invece da: dashboard app > Settings > Secrets (nel browser),
# NON caricando questo file nel repo.

DOCS_DIR = "data"
FILES_DIR = "files"
QDRANT_PATH = "databases"

GOOGLE_API_KEY = "api key"
LLM_MODEL_ASK = "gemini-3.5-flash-lite"

CHUNK_SIZE = 600
CHUNK_OVERLAP = 80
